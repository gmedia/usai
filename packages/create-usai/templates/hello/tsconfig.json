{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "types": ["@sakaladev/usai/globals"],
    "skipLibCheck": true
  },
  "include": ["src", "usai.config.ts"]
}
