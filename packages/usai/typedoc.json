{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts", "src/test.ts", "src/config.ts"],
  "tsconfig": "tsconfig.typedoc.json",
  "plugin": ["typedoc-plugin-markdown"],
  "out": "../../docs/sdk",
  "name": "@sakaladev/usai",
  "readme": "none",
  "excludeInternal": true,
  "excludePrivate": true,
  "excludeExternals": true,
  "categorizeByGroup": false,
  "sort": ["source-order"],
  "disableSources": true,
  "githubPages": false,
  "hideGenerator": true,
  "includeVersion": true,
  "cleanOutputDir": true,
  "treatWarningsAsErrors": false,
  "outputFileStrategy": "members",
  "validation": { "notExported": false, "invalidLink": true, "notDocumented": false },
  "categoryOrder": [
    "Application",
    "HTTP",
    "Streams and WebSockets",
    "Tasks, cron, commands, services",
    "Queues",
    "Resources",
    "Authentication",
    "Errors",
    "Environment",
    "Passwords",
    "Context",
    "Schemas",
    "Build",
    "Testing",
    "Configuration",
    "*"
  ],
  "flattenOutputFiles": false,
  "entryFileName": "README.md",
  "modulesFileName": "modules",
  "hidePageHeader": true,
  "hideBreadcrumbs": false,
  "useCodeBlocks": true,
  "expandObjects": true,
  "expandParameters": true,
  "parametersFormat": "table",
  "propertiesFormat": "table",
  "typeDeclarationFormat": "table",
  "indexFormat": "table"
}
