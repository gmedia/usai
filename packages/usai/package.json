{
  "name": "usai",
  "version": "0.0.1",
  "description": "Usai developer SDK: declare workloads and resources; the runtime gives each its natural lifetime.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "usai": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "usai": "./src/config.ts",
      "import": "./dist/config.js"
    },
    "./package.json": "./package.json",
    "./build/*": "./build/*"
  },
  "files": [
    "dist",
    "build",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test src/**/*.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/runtime/sdk.js"
  ],
  "dependencies": {
    "esbuild": "^0.27.0"
  }
}
