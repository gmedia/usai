{
  "name": "@sakaladev/usai",
  "version": "0.0.11",
  "description": "Usai developer SDK: declare workloads and resources; the runtime gives each its natural lifetime.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmedia/usai.git",
    "directory": "packages/usai"
  },
  "homepage": "https://github.com/gmedia/usai#readme",
  "bugs": {
    "url": "https://github.com/gmedia/usai/issues"
  },
  "keywords": [
    "usai",
    "runtime",
    "lifecycle",
    "wasm",
    "postgres",
    "typescript"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "usai": "bin/usai.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "usai": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "usai": "./src/config.ts",
      "import": "./dist/config.js"
    },
    "./package.json": "./package.json",
    "./build/*": "./build/*",
    "./test": {
      "types": "./dist/test.d.ts",
      "usai": "./src/test.ts",
      "import": "./dist/test.js"
    },
    "./globals": {
      "types": "./globals.d.ts"
    }
  },
  "files": [
    "bin",
    "build",
    "dist",
    "globals.d.ts",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --test src/**/*.test.ts",
    "docs": "typedoc && node scripts/stamp-docs.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.0",
    "typescript": "^5.9.0",
    "zod": "^4.6.5"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/runtime/sdk.js"
  ],
  "dependencies": {
    "esbuild": "^0.28.1"
  }
}
