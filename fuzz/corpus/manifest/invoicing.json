{
  "manifestVersion": 1,
  "name": "invoicing",
  "description": "Multi-tenant invoicing: API keys per tenant, invoices with line items and payments, webhook delivery through a durable queue with retries and dead-lettering, a nightly overdue sweep.",
  "modules": [
    {
      "name": "auth",
      "migrations": [
        "./src/auth/migrations/*.sql"
      ],
      "seeders": []
    },
    {
      "name": "invoices",
      "migrations": [
        "./src/invoices/migrations/*.sql"
      ],
      "seeders": [
        "./src/invoices/seeders/*.ts"
      ]
    },
    {
      "name": "webhooks",
      "migrations": [],
      "seeders": []
    }
  ],
  "workloads": [
    {
      "id": "http:POST /signup",
      "name": "POST /signup",
      "module": "auth",
      "trigger": {
        "kind": "http",
        "method": "POST",
        "path": "/signup",
        "raw": false
      },
      "contracts": {
        "body": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "email": {
              "format": "email",
              "maxLength": 200,
              "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
              "type": "string"
            },
            "name": {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            "password": {
              "maxLength": 200,
              "minLength": 12,
              "type": "string"
            },
            "tenant": {
              "pattern": "^[a-z0-9-]{2,40}$",
              "type": "string"
            }
          },
          "required": [
            "email",
            "password",
            "tenant"
          ],
          "type": "object"
        },
        "response": {
          "201": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "properties": {
              "expiresAt": {
                "type": "string"
              },
              "token": {
                "type": "string"
              }
            },
            "required": [
              "token",
              "expiresAt"
            ],
            "type": "object"
          }
        }
      },
      "errors": [
        {
          "code": "conflict",
          "status": 409
        }
      ],
      "auth": null,
      "resources": [
        "main"
      ],
      "dispatches": [],
      "publishes": [],
      "maxConcurrency": null,
      "timeoutMs": null
    },
