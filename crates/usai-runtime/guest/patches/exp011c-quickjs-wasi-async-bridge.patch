+/* ---- Usai EXP-011C stackless operation exports ---- */
+
+__attribute__((export_name("qjs_usai_install_async_bridge")))
+int32_t qjs_usai_install_async_bridge(void)
+{
+    if (!ctx || usai_bridge_install_count != 0)
+        return 1;
+    JSValue global = JS_GetGlobalObject(ctx);
+    JSValue function = JS_NewCFunction(ctx, usai_test_op, "__usai_test_op", 2);
+    int status = JS_SetPropertyStr(ctx, global, "__usai_test_op", function);
+    JS_FreeValue(ctx, global);
+    if (status < 0)
+        return 2;
+    usai_bridge_install_count++;
+    return 0;
+}
+
+__attribute__((export_name("qjs_usai_pending_op_count")))
+uint32_t qjs_usai_pending_op_count_export(void)
+{
+    return usai_pending_op_count;
+}
+
+__attribute__((export_name("qjs_usai_bridge_install_count")))
+uint32_t qjs_usai_bridge_install_count_export(void)
+{
+    return usai_bridge_install_count;
+}
+
+__attribute__((export_name("qjs_usai_next_op_id_for_test")))
+uint32_t qjs_usai_next_op_id_for_test(void)
+{
+    return usai_next_op_id;
+}
+
+__attribute__((export_name("qjs_usai_start_handler")))
+int32_t qjs_usai_start_handler(const char *scenario, uint32_t scenario_len)
+{
+    if (!ctx || !JS_IsUndefined(usai_outer_promise))
+        return 1;
+    JSValue global = JS_GetGlobalObject(ctx);
+    JSValue handler = JS_GetPropertyStr(ctx, global, "__usai_stage_a_handler");
+    JSValue argument = JS_NewStringLen(ctx, scenario, scenario_len);
+    JSValue result = JS_Call(ctx, handler, global, 1, &argument);
+    JS_FreeValue(ctx, argument);
+    JS_FreeValue(ctx, handler);
+    JS_FreeValue(ctx, global);
+    if (JS_IsException(result))
+        return 2;
+    if (!JS_IsPromise(result)) {
+        JS_FreeValue(ctx, result);
+        return 3;
+    }
+    usai_outer_promise = result;
+    return 0;
+}
+
+__attribute__((export_name("qjs_usai_outer_promise_state")))
+int32_t qjs_usai_outer_promise_state(void)
+{
+    if (!ctx || JS_IsUndefined(usai_outer_promise))
+        return JS_PROMISE_NOT_A_PROMISE;
+    return (int32_t)JS_PromiseState(ctx, usai_outer_promise);
+}
+
+__attribute__((export_name("qjs_usai_outer_result_string")))
+char *qjs_usai_outer_result_string(void)
+{
+    if (!ctx || JS_IsUndefined(usai_outer_promise))
+        return NULL;
+    JSPromiseStateEnum state = JS_PromiseState(ctx, usai_outer_promise);
+    if (state != JS_PROMISE_FULFILLED && state != JS_PROMISE_REJECTED)
+        return NULL;
+    JSValue result = JS_PromiseResult(ctx, usai_outer_promise);
+    JSValue rendered = result;
+    bool rejected_object = state == JS_PROMISE_REJECTED && JS_IsObject(result);
+    if (rejected_object) {
+        rendered = JS_GetPropertyStr(ctx, result, "code");
+        JS_FreeValue(ctx, result);
+    }
+    size_t len = 0;
+    const char *text = JS_ToCStringLen(ctx, &len, rendered);
+    if (rejected_object)
+        JS_FreeValue(ctx, rendered);
+    else
+        JS_FreeValue(ctx, result);
+    if (!text)
+        return NULL;
+    char *copy = malloc(len + 1);
+    if (copy)
+        memcpy(copy, text, len + 1);
+    JS_FreeCString(ctx, text);
+    return copy;
+}
+
+__attribute__((export_name("qjs_usai_op_complete")))
+int32_t qjs_usai_op_complete(uint32_t op_id, uint32_t status,
+                             const uint8_t *result_ptr, uint32_t result_len)
+{
+    if (!ctx)
+        return 1;
+    UsaiPendingOp *pending = usai_remove_pending(op_id);
+    if (!pending)
+        return 2;
+
+    JSValue value;
+    JSValue function;
+    if (status == 0) {
+        value = JS_NewStringLen(ctx, (const char *)result_ptr, result_len);
+        function = pending->resolve;
+    } else {
+        const char *code = status == 2 ? "EXP011C_CANCELLED" :
+                                         "EXP011C_HOST_ERROR";
+        value = usai_error(code, result_ptr, result_len);
+        function = pending->reject;
+    }
+    JSValue call_result = JS_Call(ctx, function, JS_UNDEFINED, 1, &value);
+    int32_t call_failed = JS_IsException(call_result) ? 3 : 0;
+    JS_FreeValue(ctx, call_result);
+    JS_FreeValue(ctx, value);
+    JS_FreeValue(ctx, pending->resolve);
+    JS_FreeValue(ctx, pending->reject);
+    free(pending);
+    return call_failed;
+}
