+/* ---- Usai EXP-011C split-phase operation bridge ---- */
+
+__attribute__((import_module("env"), import_name("usai_op_start")))
+extern int32_t usai_op_start(uint32_t op_id, uint32_t kind,
+                             const uint8_t *payload_ptr,
+                             uint32_t payload_len);
+
+typedef struct UsaiPendingOp {
+    uint32_t op_id;
+    JSValue resolve;
+    JSValue reject;
+    struct UsaiPendingOp *next;
+} UsaiPendingOp;
+
+static UsaiPendingOp *usai_pending_ops = NULL;
+static uint32_t usai_pending_op_count = 0;
+static uint32_t usai_next_op_id = 1;
+static uint32_t usai_bridge_install_count = 0;
+static JSValue usai_outer_promise = JS_UNDEFINED;
+
+static UsaiPendingOp *usai_remove_pending(uint32_t op_id)
+{
+    UsaiPendingOp **cursor = &usai_pending_ops;
+    while (*cursor) {
+        if ((*cursor)->op_id == op_id) {
+            UsaiPendingOp *found = *cursor;
+            *cursor = found->next;
+            usai_pending_op_count--;
+            return found;
+        }
+        cursor = &(*cursor)->next;
+    }
+    return NULL;
+}
+
+static JSValue usai_error(const char *code, const uint8_t *message,
+                          size_t message_len)
+{
+    JSValue error = JS_NewError(ctx);
+    if (JS_IsException(error))
+        return error;
+    if (JS_SetPropertyStr(ctx, error, "code", JS_NewString(ctx, code)) < 0) {
+        JS_FreeValue(ctx, error);
+        return JS_EXCEPTION;
+    }
+    if (JS_SetPropertyStr(ctx, error, "message",
+                          JS_NewStringLen(ctx, (const char *)message,
+                                          message_len)) < 0) {
+        JS_FreeValue(ctx, error);
+        return JS_EXCEPTION;
+    }
+    return error;
+}
+
+static JSValue usai_test_op(JSContext *callback_ctx, JSValueConst this_val,
+                            int argc, JSValueConst *argv)
+{
+    (void)this_val;
+    uint32_t kind = 0;
+    size_t payload_len = 0;
+    const char *payload = NULL;
+    JSValue resolving_funcs[2];
+    JSValue promise = JS_UNDEFINED;
+    UsaiPendingOp *pending = NULL;
+
+    if (argc < 2 || JS_ToUint32(callback_ctx, &kind, argv[0]) < 0)
+        return JS_ThrowTypeError(callback_ctx,
+                                 "__usai_test_op(kind, payload) requires a kind");
+    payload = JS_ToCStringLen(callback_ctx, &payload_len, argv[1]);
+    if (!payload)
+        return JS_EXCEPTION;
+    if (payload_len > UINT32_MAX) {
+        JS_FreeCString(callback_ctx, payload);
+        return JS_ThrowRangeError(callback_ctx, "operation payload is too large");
+    }
+
+    promise = JS_NewPromiseCapability(callback_ctx, resolving_funcs);
+    if (JS_IsException(promise)) {
+        JS_FreeCString(callback_ctx, payload);
+        return promise;
+    }
+
+    pending = malloc(sizeof(*pending));
+    if (!pending) {
+        JSValue error = JS_ThrowOutOfMemory(callback_ctx);
+        JS_FreeValue(callback_ctx, resolving_funcs[0]);
+        JS_FreeValue(callback_ctx, resolving_funcs[1]);
+        JS_FreeValue(callback_ctx, promise);
+        JS_FreeCString(callback_ctx, payload);
+        return error;
+    }
+    pending->op_id = usai_next_op_id++;
+    pending->resolve = resolving_funcs[0];
+    pending->reject = resolving_funcs[1];
+    pending->next = usai_pending_ops;
+    usai_pending_ops = pending;
+    usai_pending_op_count++;
+
+    int32_t start_status = usai_op_start(
+        pending->op_id, kind, (const uint8_t *)payload, (uint32_t)payload_len);
+    JS_FreeCString(callback_ctx, payload);
+
+    if (start_status != 0) {
+        UsaiPendingOp *rejected = usai_remove_pending(pending->op_id);
+        static const uint8_t message[] = "operation start rejected";
+        JSValue error = usai_error("EXP011C_START_REJECTED", message,
+                                   sizeof(message) - 1);
+        JSValue call_result = JS_Call(callback_ctx, rejected->reject,
+                                      JS_UNDEFINED, 1, &error);
+        JS_FreeValue(callback_ctx, call_result);
+        JS_FreeValue(callback_ctx, error);
+        JS_FreeValue(callback_ctx, rejected->resolve);
+        JS_FreeValue(callback_ctx, rejected->reject);
+        free(rejected);
+    }
+
+    return promise;
+}
