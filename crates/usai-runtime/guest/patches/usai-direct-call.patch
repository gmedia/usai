+/* ---- Usai direct-call ABI (ADR-0018) ----
+ *
+ * The runtime enters the guest through the bridge's functions instead of
+ * evaluating a snippet per request: `__usai[name](arg)` with one string
+ * argument, the result returned like `qjs_eval`'s (a heap JSValue the host
+ * inspects with `qjs_is_exception` / `qjs_get_string` and frees). No
+ * parsing, no compilation, no temporary script object on the hot path. */
+
+__attribute__((export_name("qjs_usai_call")))
+JSValue *qjs_usai_call(const char *name, size_t name_len, const char *arg, size_t arg_len)
+{
+    JSValue global = JS_GetGlobalObject(ctx);
+    JSValue bridge = JS_GetPropertyStr(ctx, global, "__usai");
+    JSValue fn = JS_UNDEFINED;
+    JSValue result;
+    if (JS_IsObject(bridge)) {
+        JSAtom atom = JS_NewAtomLen(ctx, name, name_len);
+        fn = JS_GetProperty(ctx, bridge, atom);
+        JS_FreeAtom(ctx, atom);
+    }
+    if (!JS_IsFunction(ctx, fn)) {
+        result = JS_ThrowTypeError(ctx, "__usai.%.*s is not a function",
+                                   (int)name_len, name);
+    } else {
+        JSValue argument = JS_NewStringLen(ctx, arg, arg_len);
+        result = JS_Call(ctx, fn, bridge, 1, &argument);
+        JS_FreeValue(ctx, argument);
+    }
+    JS_FreeValue(ctx, fn);
+    JS_FreeValue(ctx, bridge);
+    JS_FreeValue(ctx, global);
+    return jsvalue_to_heap(result);
+}
+
 __attribute__((export_name("qjs_promise_state")))
 int qjs_promise_state(JSValue *promise) {
     return (int)JS_PromiseState(ctx, *promise);
