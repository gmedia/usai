+/* Usai EXP-011A: see the declaration in quickjs.h. The state must be non-zero,
+   the same invariant JS_NewContextRaw enforces at seeding time. */
+void JS_UsaiSetRandomSeed(JSContext *ctx, uint64_t seed)
+{
+    if (seed == 0)
+        seed = 1;
+    ctx->random_state = seed;
+}
